# Synology host:port (no scheme)
SYNO_HOST=synology.local:5001

# Credentials
SYNO_USER=your_username
SYNO_PASSWORD=your_password

# Camera selection
SYNO_CAMERA=Front Door

# Stream profile: 0 = main (high-res), 1 = sub-stream (lower-res)
SYNO_PROFILE=0

# Seconds to wait for the first decodable frame
SYNO_TIMEOUT=30

# Directory to write screenshots into (must exist)
SYNO_OUTPUT_DIR=.

# SSL verification — TRUE by default. Set to FALSE only for self-signed certs.
SYNO_VERIFY_SSL=true

# Watchdog: attempts before restart and minimum accepted snapshot size in bytes
WATCHDOG_ATTEMPTS=2
WATCHDOG_MIN_BYTES=10240
# WATCHDOG_DEBUG_SCREENSHOT=watchdog-debug.png
# WATCHDOG_RESTART_SCRIPT=./restart.sh
